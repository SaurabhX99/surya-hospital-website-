# Copy this file to .env and fill in your values.
# Leave Twilio blank to skip notifications — appointments still save to the database.

# ── MongoDB ─────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
DATABASE_NAME=NIMMS_HOSPITAL

# ── Tenant ──────────────────────────────────────────────────────────
# Unique identifier for this hospital. Used to scope all DB queries.
# Change this per deployment — never share the same value across hospitals.
TENANT_NAME=vedansh_medicare

# ── Blog uploads ────────────────────────────────────────────────────
# Directory where uploaded article files are stored (relative to main.py)
UPLOAD_DIR=static/blogs

# ── Admin Credentials (first-run seed) ──────────────────────────────
# Set these BEFORE first run to create the initial admin user.
# Once the user is created, changing these has no effect unless you
# manually delete the admin_users collection.
ADMIN_EMAIL=admin@vedanshmedicare.com
ADMIN_PASSWORD=Change_Me_Now!

# ── Security ────────────────────────────────────────────────────────
# Layer 1: Static API key sent by the frontend via X-Api-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy the same value into frontend/_config.js → PUBLIC_API_KEY
PUBLIC_API_KEY=

# Layer 3: HMAC secret for signing short-lived page tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this server-side only — never expose it to the frontend.
PAGE_TOKEN_SECRET=

# Layer 3: Token lifetime in minutes (default: 60)
PAGE_TOKEN_TTL_MINUTES=60

# Layer 2: Comma-separated list of allowed origin domains.
# Leave blank to skip origin checking (safe for local dev).
# Example: https://vedanshmedicare.com,https://www.vedanshmedicare.com
ALLOWED_ORIGINS=

# ── Twilio ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Twilio WhatsApp sandbox default — change once you have a dedicated WA number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
